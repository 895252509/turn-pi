{
	"name": "turn-pi",
	"version": "0.2.0",
	"description": "Turn Pi — a self-hosted web UI for the Pi coding agent.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/895252509/turn-pi.git"
	},
	"homepage": "https://github.com/895252509/turn-pi#readme",
	"bugs": {
		"url": "https://github.com/895252509/turn-pi/issues"
	},
	"engines": {
		"node": ">=22.18"
	},
	"keywords": [
		"pi",
		"coding-agent",
		"web-ui",
		"self-hosted",
		"ai-agent"
	],
	"scripts": {
		"start": "node server/index.ts",
		"dev": "node --watch-path=./server server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build:web": "vite build --config web/vite.config.ts",
		"typecheck": "tsc -p web/tsconfig.json --noEmit",
		"smoke:web": "node web/scripts/smoke.mjs",
		"check:web": "npm run typecheck && npm run build:web && npm run smoke:web",
		"smoke:mobile": "node web/scripts/mobile-smoke.mjs",
		"check:workspace-tools": "node scripts/check-workspace-tools.mjs",
		"check:worktree-deps": "node scripts/check-worktree-deps.mjs",
		"pull:idle": "node scripts/pull-when-idle.mjs",
		"check:search": "node scripts/check-search.mjs",
		"check:git-panel": "node scripts/check-git-panel.mjs",
		"check:agent-card": "node scripts/check-agent-card.mjs",
		"check:agent-spec": "node scripts/check-agent-spec.mjs",
		"check:mcp": "node scripts/check-mcp.mjs",
		"check:worktree-guidance": "node scripts/check-worktree-guidance.mjs"
	},
	"dependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@lezer/highlight": "^1.2.5",
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.15",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@radix-ui/react-slot": "^1.2.3",
		"@types/node": "^22.15.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"autoprefixer": "^10.4.21",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"happy-dom": "^21.0.4",
		"lucide-react": "^0.468.0",
		"playwright-core": "^1.64.1",
		"postcss": "^8.5.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.3.0",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"zustand": "^5.0.5"
	}
}
