# 复制成 .env 再填
OPENCODE_API_KEY=
# 访问控制：不填会自动生成并打印到启动日志，也可以固定在这里。
# PI_ACCESS_TOKEN=
# 凭据 vault 主密钥（base64 32 字节）；不填会自动生成 runtime/credentials.key。
# PI_CREDENTIAL_KEY=
PI_PROVIDER=opencode-go
PI_MODEL=deepseek-v4.1-flash
# 自定义供应商的 API Key 也走环境变量；设置页只填变量名，不填值。
# 供应商配置默认写到 $PI_RUNTIME_DIR/providers.json。
# PI_PROVIDER_CONFIG=/runtime/providers.json
NPM_REGISTRY=https://registry.npmmirror.com
# 构建时的 Debian 源：默认阿里云 http（不用改；置空则走官方源）
# DEBIAN_MIRROR=
# 宿主上给 agent 读写的工作区（compose 挂到容器内 /workspace）；默认 ./data/workspace
# PI_WORKSPACE_PATH=/path/to/projects
# 容器内 docker CLI 用哪个宿主 socket（只在叠加 docker-compose.docker.yml 时生效）
# DOCKER_SOCK=/var/run/docker.sock
# compose 的 default 网络网段。和已有 docker 网络重叠时 up 会报 Pool overlaps，
# 改这里（或 `TURN_PI_SUBNET=10.x.y.0/24 make up`）即可，不用改 compose。
# TURN_PI_SUBNET=10.211.78.0/24

# 可选：workspace 注册表（默认 $PI_RUNTIME_DIR/workspaces.json）
# PI_WORKSPACES_FILE=/runtime/workspaces.json
# git（默认，只发现一级 git 仓库）/ all（一级目录）/ none
# PI_WORKSPACE_DISCOVER=git
# 隔离 worktree（只在容器内使用；默认 $PI_RUNTIME_DIR/worktrees）
# PI_WORKTREE_ROOT=/runtime/worktrees
# PI_WORKTREES_FILE=/runtime/worktrees.json
# 进程内定时任务（状态文件默认 $PI_RUNTIME_DIR/jobs/scheduler.json）
# PI_JOBS_FILE=/runtime/jobs/scheduler.json
# 启动后延迟多久才考虑补跑（毫秒；默认 60000）
# PI_JOB_STARTUP_DELAY_MS=60000

# ---- 联网搜索（web_search / web_fetch）----
# 顺序即降级顺序；空着 = 自动探测（searxng → tavily → brave → exa → exa-mcp）
# 什么都没配时自动用 exa-mcp（免 key，但 query 会发给 Exa）
# PI_EXA_MCP_URL=https://mcp.exa.ai
# PI_SEARCH_PROVIDERS=tavily,searxng
# 自建 SearXNG：无 key，最省事（需要实例开启 json 格式）
# PI_SEARXNG_URL=http://searxng:8080
# 托管服务（也可以存进设置 → 凭据的 env 层，vault 优先）
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# 返回给模型的正文上限（web_fetch）与单次搜索超时
# PI_FETCH_MAX_CHARS=12000
# PI_SEARCH_TIMEOUT_MS=9000
# 每会话 10 分钟搜索次数上限
# PI_SEARCH_MAX_PER_10MIN=40
# web_fetch 出站策略（每次调用重读）
# PI_FETCH_ALLOW_DOMAINS=            # 非空则只允许这些域名（含子域）
# PI_FETCH_DENY_DOMAINS=internal.example.com
# PI_FETCH_REDIRECTS=same-origin     # 默认 any
# 抓取正文字符上限（回给模型的部分）与全文暂存上限（read_fetched 分页用）
# PI_FETCH_MAX_FULL_CHARS=400000
# PI_CONTENT_TTL_MS=1800000
# PI_CONTENT_MAX_ENTRIES=32
# PI_CONTENT_MAX_CHARS=8000000
# provider 白名单：模型不能靠 provider 参数越权换一家（空 = 不限制）
# PI_SEARCH_ALLOWED_PROVIDERS=searxng,tavily

# 可选：提高 GitHub API 限额（技能市场目录）
# GITHUB_TOKEN=
# 技能市场缓存 / 翻译缓存（默认在 $PI_RUNTIME_DIR 下）
# PI_SKILL_MARKET_FILE=/runtime/skill-market.json
# PI_SKILL_TRANSLATIONS=/runtime/skill-translations.json
# PI_SKILL_CONTENT_CACHE=/runtime/skill-market-content.json

# MCP：平台托管一份配置（默认 $PI_RUNTIME_DIR/mcp.json，形状同 Claude Desktop 的 mcpServers）
# PI_MCP_FILE=/runtime/mcp.json
# 0 = 所有会话都不接 MCP（排障用）
# PI_MCP=0
